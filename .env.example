# Copy this file to .env and fill in your key.
# The agents work without a key (deterministic fallback reasoning),
# but a real key makes Red/Blue reason and generate patches live.

# OpenAI (or any OpenAI-compatible provider)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional: point at an OpenAI-compatible endpoint (e.g. Together, Groq, local)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Pacing of the live demo (ms between dramatic beats). Lower = faster.
BEAT_MS=650

# Supabase (optional). Persists every run + its full event timeline so
# score history survives across restarts and demos. Without these, the
# app still works fine — it just keeps everything in memory only.
# Project → Settings → API. Use the SERVICE ROLE key (server-side only,
# never expose it to a browser) — schema is in supabase/schema.sql.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
