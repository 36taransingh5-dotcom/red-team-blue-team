{
  "name": "red-team-blue-team",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous offensive and defensive AI agents that continuously attack and defend software.",
  "scripts": {
    "dev": "concurrently -n SERVER,WEB -c red,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --experimental-sqlite --no-warnings server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "npm run dev",
    "preflight": "node --experimental-sqlite --no-warnings scripts/preflight.js",
    "clear-history": "node scripts/clear-history.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@supabase/supabase-js": "^2.45.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "openai": "^4.67.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "nodemon": "^3.1.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.8"
  }
}
